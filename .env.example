PORT=3100
DEEPSEEK_API_KEY=sk-your_api_key_here

# V1.62 局域网访问：默认 false 仅监听 127.0.0.1；true 时监听 0.0.0.0 并只放行私有网段
LAN_ACCESS=false
# 局域网模式下自助注册默认关闭；设为 true 可强制开启
ALLOW_SELF_REGISTER=
# 会话密钥（可选；留空自动生成并保存在 data/.session-secret）
SESSION_SECRET=
# V1.63.1 备份策略
# 每日自动备份时间（本地小时 0-23，默认 10 点）
BACKUP_AUTO_HOUR=10
# 自动/手动备份保留份数（默认 7 份，约 7 天）
BACKUP_AUTO_KEEP=7
# 是否启用每日自动备份（默认 true）
BACKUP_AUTO_ENABLED=true
# 启动前快照默认完全关闭；如需在结构迁移前临时开启设为 true（保留份数默认 3）
BACKUP_STARTUP_ENABLED=false
BACKUP_STARTUP_KEEP=3
